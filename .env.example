# Copy to .env and fill in your project settings.
# Browser-safe Supabase public configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server configuration, using the same Supabase project
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for AI quota RPC only; server-only, never a VITE_ variable.
# Configure separately for each isolated environment after migration 008 is authorized.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only AI key; never use a VITE_ prefix
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
PORT=3001
