{
  "name": "learnspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch --import tsx server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/live-smoke.ts && node --import tsx scripts/live-access.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.1",
    "dotenv": "^16.4.7",
    "express": "4.21.2",
    "idb": "8.0.2",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "5.4.14"
  }
}
